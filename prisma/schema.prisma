generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CLIENT
  BARBER
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(CLIENT)
  image     String?
  phone     String?
  bio       String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments       Appointment[]
  barberAppointments Appointment[]  @relation("BarberAppointments")
  services           Service[]
  reviews            Review[]
  barberReviews      Review[]       @relation("BarberReviews")
  availabilities     Availability[]

  @@map("users")
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  duration    Int
  price       Float
  barberId    String
  barber      User     @relation(fields: [barberId], references: [id], onDelete: Cascade)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  appointments Appointment[]

  @@map("services")
}

model Appointment {
  id        String            @id @default(cuid())
  userId    String
  barberId  String
  serviceId String
  date      DateTime
  startTime String
  endTime   String
  status    AppointmentStatus @default(PENDING)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  barber  User    @relation("BarberAppointments", fields: [barberId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("appointments")
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  barberId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  barber User @relation("BarberReviews", fields: [barberId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Availability {
  id        String  @id @default(cuid())
  barberId  String
  dayOfWeek Int
  startTime String
  endTime   String
  isActive  Boolean @default(true)

  barber User @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, dayOfWeek])
  @@map("availabilities")
}
